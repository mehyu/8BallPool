<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/board"
        android:layout_width="@dimen/boardWidth"
        android:layout_height="@dimen/boardHeight"
        android:layout_gravity="center"
        tools:ignore="UselessParent">

        <com.letsgo.goated.Normal
            android:id="@+id/normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.letsgo.goated.Trickshot
            android:id="@+id/trickshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.letsgo.goated.NineBall
            android:id="@+id/nineBall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_adjust_panel"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="15dp"
            android:background="#F0000000"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CALIBRATE OVERLAY"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Pos X -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pos X:"
                            android:textColor="#00FF00"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_pos_x"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_pos_x"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="100"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_pos_x"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Pos Y -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pos Y:"
                            android:textColor="#00FF00"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_pos_y"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_pos_y"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="100"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_pos_y"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Board W -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Board W:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_board_w"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_board_w"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1350"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_board_w"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Board H -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Board H:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_board_h"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_board_h"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="598"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_board_h"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Canvas W -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Canvas W:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_canvas_w"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_canvas_w"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1215"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_canvas_w"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Canvas H -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Canvas H:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_canvas_h"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_canvas_h"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="487"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_canvas_h"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Margin T -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Margin T:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_margin"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_margin"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="55"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_margin"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Step Size -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Step Size:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_step_1"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:textSize="10sp"
                            android:text="1px"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <Button
                            android:id="@+id/btn_step_5"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:textSize="10sp"
                            android:text="5px"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="2dp" />
                        <Button
                            android:id="@+id/btn_step_20"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:textSize="10sp"
                            android:text="20px"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>

                    <!-- Opacity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Opacity:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_dec_opacity"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="-"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                        <TextView
                            android:id="@+id/txt_opacity"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="100%"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_inc_opacity"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:textSize="11sp"
                            android:text="+"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                    <!-- Line Color -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Line Color:"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                        <Button
                            android:id="@+id/btn_cycle_color"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.8"
                            android:textSize="10sp"
                            android:text="WHITE"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_toggle_guide"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="8sp"
                    android:text="GUIDE"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:layout_marginEnd="1dp" />
                <Button
                    android:id="@+id/btn_auto_align"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="8sp"
                    android:text="AUTO"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:layout_marginEnd="1dp" />
                <Button
                    android:id="@+id/btn_save_config"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="8sp"
                    android:text="SAVE"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:layout_marginEnd="1dp" />
                <Button
                    android:id="@+id/btn_reset_config"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="8sp"
                    android:text="RESET"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:layout_marginEnd="1dp" />
                <Button
                    android:id="@+id/btn_close_panel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textSize="8sp"
                    android:text="CLOSE"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- FLOATING FIXED CONTROL BAR (Will never deform, stretch or overlap!) -->
    <LinearLayout
        android:id="@+id/layout_control_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:background="#A0000000"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_adjust"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:background="#80000000"
            android:text="ADJUST"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"
            tools:ignore="TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_normal"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:background="@drawable/button_normal"
            android:text="@string/normal"
            android:textColor="@color/colorWhite"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"
            tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_trickshot"
            android:layout_width="75dp"
            android:layout_height="36dp"
            android:background="@drawable/button_trickshot"
            android:text="@string/trickshot"
            android:textColor="@color/colorWhite"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"
            tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_nineBall"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:background="@drawable/button_nineball"
            android:text="@string/nineBall"
            android:textColor="@color/colorWhite"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"
            tools:ignore="ContentDescription,TextContrastCheck,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_trickshot_second_ine"
            android:layout_width="85dp"
            android:layout_height="36dp"
            android:background="@drawable/button_trickshot_second_line"
            android:text="@string/trickshot_second_line"
            android:textColor="@color/colorWhite"
            android:textSize="9sp"
            android:visibility="gone"
            android:layout_marginEnd="4dp"
            tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btn_hide"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:background="@drawable/button_hide"
            android:text="@string/hide"
            android:textColor="@color/colorWhite"
            android:textSize="10sp"
            tools:ignore="ContentDescription,TouchTargetSizeCheck" />
    </LinearLayout>

</FrameLayout>
